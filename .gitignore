# ==========================================
#  Git Ignore for Flood & Emergency System
# ==========================================

# Node & Frontend dependencies
node_modules/
*/node_modules/
frontend/node_modules/

# Production build artifacts
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python cache & bytecode
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Database & User Uploads
*.db
backend/uploads/*
!backend/uploads/.gitkeep
